# Credentials for the live-site tests (`npm run test:live`).
#
# Copy to `.env` and fill in. `.env` is gitignored — keep it that way.
# Use a throwaway account, not your main one: the tests log in for real.
AMQ_TEST_ACCOUNT_USERNAME=
AMQ_TEST_ACCOUNT_PASSWORD=

# Credentials for the local scripts (`local/`, e.g. `npm run anime-titles`).
# These usually want the account whose list matters, and logging in takes over
# any session that account has open. Left empty, the test account is used.
AMQ_ACCOUNT_USERNAME=
AMQ_ACCOUNT_PASSWORD=
