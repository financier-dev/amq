# Credentials for the live-site tests (`npm run test:live`).
#
# Copy this file to `.env` and fill it in. `.env` is gitignored; keep it so.
# Use a throwaway account, not your main one. The tests log in for real.
AMQ_TEST_ACCOUNT_USERNAME=
AMQ_TEST_ACCOUNT_PASSWORD=

# Credentials for the local scripts (`local/`, e.g. `npm run anime-titles`).
# Use the account whose anime list you want to read. Logging in disconnects
# any session that account has open. If these are empty, the scripts use the
# test account.
AMQ_ACCOUNT_USERNAME=
AMQ_ACCOUNT_PASSWORD=

# Optional. `npm run watch-rooms` also posts its alerts to this Discord
# webhook. Anyone with the URL can post to the channel; keep it here only.
ROOM_ALERT_DISCORD_WEBHOOK=

# Optional. Where `npm run video-cache` keeps song videos. Default: ~/amq-cache
AMQ_VIDEO_CACHE_DIR=
