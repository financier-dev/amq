#!/bin/sh
#
# Keeps the committed userscripts in step with the source they were built from,
# and keeps secrets out of a public repo.
#
# dist/ is tracked so a script can be installed straight from GitHub, which
# means a source change committed without a rebuild ships a stale build. This
# rebuilds and stages dist/ whenever anything that feeds a bundle is part of
# the commit.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one commit:    git commit --no-verify

set -e

staged=$(git diff --cached --name-only)

# Nothing that affects a bundle? Then there is nothing to rebuild.
if echo "$staged" | grep -qE '^(ui/src/|shared/|build/|vite\.config\.ts$|svelte\.config\.js$|package(-lock)?\.json$)'; then
  # The build reads the working tree, not the index, so anything staged only in
  # part would still reach dist. Worth saying out loud rather than silently
  # shipping a build of work that is not in this commit.
  unstaged=$(git diff --name-only -- ui/src shared build vite.config.ts svelte.config.js package.json)
  if [ -n "$unstaged" ]; then
    echo "pre-commit: warning — these are modified but not staged, and the rebuild will include them:"
    echo "$unstaged" | sed 's/^/  /'
  fi

  echo "pre-commit: rebuilding dist/"
  npm run build --silent
  git add dist
fi

# This repo is public, and the scripts moving into it have carried hardcoded
# account details. A commit is the last cheap moment to catch that.
#
# Added lines only, and a deliberately narrow pattern: a secret-ish name
# assigned a literal value. The three exclusions are what keep it quiet enough
# to leave enabled — without them this fires on ordinary code:
#
#   password?: string                          a type annotation
#   AMQ_TEST_ACCOUNT_PASSWORD=                 an empty env template
#   password: document.querySelector(…)        a value read at runtime
#   'room_browser.….wrong_password': 'Wrong Password'   an i18n key
#
# A line carrying both an i18n key and a real secret would slip through. This
# is a backstop for the obvious shapes, not the check — read the diff.
secrets=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude)package-lock.json' |
  grep -E '^\+' | grep -vE '^\+\+\+' |
  grep -iE "(password|passwd|secret|api[_-]?key|auth[_-]?token|credential)[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[^\"'[:space:],;)}]{4,}" |
  grep -viE "[:=][[:space:]]*[\"']?(string|number|boolean|any|unknown|undefined|null)\b" |
  grep -viE "[:=][[:space:]]*[A-Za-z_\$][A-Za-z0-9_\$]*[.(]" |
  grep -viE "[\"'][a-z0-9_]+(\.[a-z0-9_]+)+[\"'][[:space:]]*:" || true)

if [ -n "$secrets" ]; then
  echo "pre-commit: possible secret in the staged diff — this repo is public:"
  echo "$secrets" | sed 's/^/  /'
  echo "pre-commit: refusing. Read those lines; use --no-verify if they are false positives."
  exit 1
fi

# Personal details: this repo deliberately carries none. Catch the common ones
# rather than every possible shape.
personal=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude)package-lock.json' |
  grep -E '^\+' | grep -vE '^\+\+\+' |
  grep -iE "(/Users/[a-z0-9._-]+|[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,})" || true)

if [ -n "$personal" ]; then
  echo "pre-commit: possible personal detail (home path or email) in the staged diff:"
  echo "$personal" | sed 's/^/  /'
  echo "pre-commit: refusing. Use ~/ instead of an absolute home path; --no-verify to override."
  exit 1
fi
